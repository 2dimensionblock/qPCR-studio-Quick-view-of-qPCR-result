{
  "name": "qpcr-studio-desktop",
  "version": "1.0.0",
  "description": "Offline qPCR analysis and plotting with a Windows desktop interface",
  "author": "Steven Liu",
  "license": "MIT",
  "private": true,
  "main": "app/main.cjs",
  "engines": {"node": ">=24 <25"},
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.mjs",
    "check": "node scripts/check-project.mjs",
    "dist:win": "node scripts/build-windows.cjs",
    "smoke:windows": "node scripts/run-electron-smoke.cjs",
    "verify:dist": "node scripts/verify-dist.cjs",
    "release:files": "node scripts/release-files.mjs"
  },
  "devDependencies": {
    "electron": "44.5.0",
    "electron-builder": "26.15.3",
    "jsdom": "27.0.0"
  },
  "build": {
    "appId": "com.stevenliu.qpcrstudio",
    "productName": "qPCR Studio",
    "copyright": "Steven Liu",
    "electronVersion": "44.5.0",
    "asar": true,
    "npmRebuild": false,
    "compression": "normal",
    "directories": {"output": "dist", "buildResources": "build"},
    "files": ["app/**/*", "package.json"],
    "extraResources": [
      {"from": "LICENSE", "to": "LICENSE.qPCR-Studio.txt"},
      {"from": "THIRD_PARTY_NOTICES.md", "to": "THIRD_PARTY_NOTICES.md"}
    ],
    "win": {
      "target": [{"target": "portable", "arch": ["x64"]}],
      "icon": "build/icon.ico",
      "signExecutable": false
    },
    "portable": {"artifactName": "qPCR_Studio_Windows_x64.exe", "requestExecutionLevel": "user"}
  }
}
